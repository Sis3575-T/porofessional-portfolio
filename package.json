{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "frontend/*",
    "backend",
    "backend/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,admin -c cyan,green,magenta \"node --use-system-ca --watch backend/src/server.js\" \"cd frontend/web && npm run dev\" \"cd frontend/admin && npm run dev\"",
    "dev:all": "concurrently -n api,web,admin -c cyan,green,magenta \"node --use-system-ca --watch backend/src/server.js\" \"cd frontend/web && npm run dev\" \"cd frontend/admin && npm run dev\"",
    "dev:backend": "node --use-system-ca --watch backend/src/server.js",
    "dev:web": "npm --workspace frontend/web run dev",
    "dev:admin": "npm --workspace frontend/admin run dev",
    "start": "node --use-system-ca backend/src/server.js",
    "db:snapshot": "npm --workspace backend run db:snapshot",
    "db:restore": "npm --workspace backend run db:restore",
    "test:persistence": "node --use-system-ca scripts/verify-full-persistence.mjs",
    "test:admin": "node --use-system-ca scripts/verify-admin-e2e.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "lightningcss": "^1.33.0",
    "terser": "^5.49.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^5.22.0",
    "nodemailer": "^6.9.0",
    "ws": "^8.22.0"
  }
}
