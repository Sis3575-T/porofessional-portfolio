# Postgres connection string (Neon pooled URL recommended, include sslmode=require).
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Single owner account. Generate the hash with: npm run hash-password -- "your password"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=scrypt:salthex:hashhex

# Random string, 32+ characters: openssl rand -base64 48
SESSION_SECRET=

# Vercel Blob read/write token (set automatically when you connect a Blob store).
BLOB_READ_WRITE_TOKEN=

# Public URL used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
