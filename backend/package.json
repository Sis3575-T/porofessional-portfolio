{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.22.0",
    "resend": "^6.18.1",
    "shared": "file:./shared",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^5.22.0",
    "ws": "^8.22.0"
  },
  "scripts": {
    "build": "node -e \"try { require('child_process').execSync('npx prisma generate --schema=prisma/schema.prisma', { stdio: 'inherit' }); } catch(e){ console.warn(e.message); }\"",
    "postinstall": "exit 0",
    "dev": "node --use-system-ca --watch-path=src --watch-path=shared --watch src/server.js",
    "start": "node src/server.js",
    "db:seed": "node prisma/seed.js",
    "db:snapshot": "node prisma/export-db-snapshot.js",
    "db:restore": "node prisma/restore-db-snapshot.js"
  }
}
